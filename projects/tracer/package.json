{
  "name": "nocorny-tracer",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3107",
    "build": "next build",
    "start": "next start -p 3107",
    "typecheck": "tsc --noEmit",
    "postinstall": "bash -c 'if [ -L node_modules/@aisoldier/ui-kit ]; then rm node_modules/@aisoldier/ui-kit; fi && if [ ! -d node_modules/@aisoldier/ui-kit ]; then cp -r ../../ui-kit node_modules/@aisoldier/; fi'"
  },
  "dependencies": {
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "framer-motion": "^12.0.0",
    "lenis": "^1.1.20",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.0.0",
    "@aisoldier/ui-kit": "file:../../ui-kit"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/node": "^22.10.0",
    "tailwindcss": "^4.0.0",
    "@tailwindcss/postcss": "^4.0.0",
    "postcss": "^8.4.49"
  }
}
